          "id": "98f5b8a9-3bec-4ca7-9ad5-d12910241ee9",
          "name": "Backupify SaaS Protection API Bulk Seat Change",
          "request": {
            "name": "Backupify SaaS Protection API Bulk Seat Change",
            "description": {
              "content": "Updates multiple Microsoft 365 or Google Workspace seats simultaneously. Supports licensing, unlicensing, and pausing up to 100 seats per request. Supported seat types include User, SharedMailbox, Site, TeamSite, and Team.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "saas",
                ":saasCustomerId",
                "externalSubscriptionId",
